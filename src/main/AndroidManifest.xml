<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions required by AutoPhone accessibility layer -->
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application>

        <!--
             AutoPhone Accessibility Service
             Forge OS accessibility layer for UI inspection, gesture dispatch,
             and programmatic text input across any foreground app.
        -->
        <service
            android:name="com.forge.autophone.AutoPhoneAccessibilityService"
            android:exported="true"
            android:label="@string/autophone_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/autophone_accessibility_config" />
        </service>

    </application>
</manifest>
